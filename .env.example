# Arc Runtime — environment variables
# Copy to .env and fill in your keys.

# ── API Keys ──────────────────────────────────────────────────────────────
# xAI Grok (failsafe provider)
ARC_XAI_KEY=xai-your-key-here

# nexos.ai (compute offset provider — OpenAI-compatible gateway)
# Headers sent: Authorization: Bearer <key>  AND  X-Api-Key: <key>
ARC_NEXOS_KEY=nexos-your-key-here
# Optional overrides for a Hostinger/private OpenAI-compatible gateway.
# ARC_NEXOS_BASE_URL=https://api.nexos.ai/v1
# ARC_NEXOS_MODEL=meta-llama/llama-3.3-70b-instruct

# Local model bearer token (if your Ollama/llama.cpp has auth)
# ARC_LOCAL_KEY=

# ── Server ────────────────────────────────────────────────────────────────
ARC_PORT=7860

# ── Paths (override config/arc_config.yaml) ───────────────────────────────
# ARC_DB_PATH=data/arc.db
# ARC_LOCAL_ENDPOINT=http://localhost:11434/v1
